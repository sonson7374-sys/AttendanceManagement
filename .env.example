# ============================================================
# GPS 지오펜스 출퇴근 관리 시스템 — 환경변수 템플릿
#
# 사용법:
#   cp .env.example .env
#   .env 파일을 열어 실제 값으로 수정
#
# 주의: .env 파일은 절대 Git에 커밋하지 않습니다.
# ============================================================

# ────────────────────────────────────────
# PostgreSQL
# 기본값은 docker-compose로 띄운 로컬 컨테이너를 가리킨다.
# Supabase 등 외부 관리형 Postgres를 쓰려면 DB_HOST/DB_PORT/DB_SSL_MODE를
# 해당 프로젝트 값으로, POSTGRES_USER/PASSWORD를 발급받은 서비스 계정으로 바꾸면 된다
# (이 경우 로컬 postgres 컨테이너는 띄우지 않아도 된다).
# ────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
# 로컬 컨테이너는 SSL을 쓰지 않는다. Supabase 등 외부 DB는 require로 설정.
DB_SSL_MODE=disable
POSTGRES_DB=attendance
POSTGRES_USER=attendance
# 로컬: 임의 값 / 운영·외부 DB: 발급받은 강력한 비밀번호 사용
POSTGRES_PASSWORD=local_dev_password_change_me
# docker-compose가 컨테이너에 매핑할 로컬 포트 (다른 PostgreSQL과 충돌 시 변경)
POSTGRES_PORT=5432

# ────────────────────────────────────────
# Redis
# ────────────────────────────────────────
REDIS_PASSWORD=local_redis_password_change_me
REDIS_PORT=6379

# ────────────────────────────────────────
# Spring Boot Backend
# ────────────────────────────────────────
SPRING_PROFILES_ACTIVE=local

# JWT
# 운영 환경: 최소 32자 이상의 무작위 문자열 사용
JWT_SECRET=local_dev_jwt_secret_must_be_at_least_32_characters_long
JWT_ACCESS_TOKEN_EXPIRE_SECONDS=1800
JWT_REFRESH_TOKEN_EXPIRE_DAYS=14

# 서버 포트
BACKEND_PORT=8080

# ────────────────────────────────────────
# Geofence 기본 정책
# ────────────────────────────────────────
GEOFENCE_DEFAULT_RADIUS_METERS=100
GEOFENCE_MAX_ACCURACY_METERS=50
GEOFENCE_MAX_LOCATION_AGE_SECONDS=30
GEOFENCE_RETRY_COUNT=3
GEOFENCE_ALLOW_MOCK_LOCATION=false
GEOFENCE_ALLOW_OUTSIDE_CHECK_IN=false
GEOFENCE_ALLOW_OUTSIDE_CHECK_OUT=false

# ────────────────────────────────────────
# Admin Web (React / Vite)
# ────────────────────────────────────────
ADMIN_WEB_PORT=3000

# 지도 공급자 (kakao | naver | google)
VITE_MAP_PROVIDER=kakao
VITE_MAP_API_KEY=your_kakao_map_javascript_api_key_here

# 백엔드 API URL (Admin Web에서 사용)
VITE_API_BASE_URL=http://localhost:8080/api/v1

# ────────────────────────────────────────
# Nginx
# ────────────────────────────────────────
NGINX_HTTP_PORT=80

# ────────────────────────────────────────
# Firebase Cloud Messaging (선택, 푸시 알림)
# ────────────────────────────────────────
# FIREBASE_PROJECT_ID=
# FIREBASE_PRIVATE_KEY_ID=
# FIREBASE_PRIVATE_KEY=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_CLIENT_ID=

# ────────────────────────────────────────
# 모니터링 (docker compose --profile monitoring up -d)
# ────────────────────────────────────────
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_USER=admin
GRAFANA_PASSWORD=change_me_grafana_password

# ────────────────────────────────────────
# 로깅
# ────────────────────────────────────────
# local: DEBUG, dev/prod: INFO
LOG_LEVEL=DEBUG
